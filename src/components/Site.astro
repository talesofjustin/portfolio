---
import '../styles/site.css';
import body from './body.html?raw';
import { getContent } from '../lib/content';

interface Props { title?: string; description?: string; image?: string; path?: string }
const { title, description, image, path = '/' } = Astro.props;
const c = await getContent();

// media urls, resolved the same way the script does it
const m = c.media as any, L = c.local;
const IMG = (n: string, w = 1600) => m[n]?.img ? `${m[n].img}${m[n].img.includes('?') ? '&' : '?'}w=${w}&auto=format&q=80` : `${L}${n}.jpg`;
const VID = (n: string) => m[n]?.mp4 ? `${m[n].mp4}${m[n].lo || '720p'}.mp4` : `${L}${n}.mp4`;
const PST = (n: string) => m[n]?.poster || `${L}${n}-poster.jpg`;
const hero = c.landing[0] || c.projects[0]?.video;
const s = c.settings as any;
const html = body
  .replaceAll('{{HERO_VID}}', VID(hero)).replaceAll('{{HERO_PST}}', PST(hero))
  .replaceAll('{{ABOUT_IMG}}', IMG(s.aboutImage, 2400))
  .replaceAll('{{SEA_VID}}', VID(s.contactVideo)).replaceAll('{{SEA_PST}}', PST(s.contactVideo))
  .replaceAll('https://www.instagram.com/talesofjustin', s.instagram)
  .replaceAll('https://www.youtube.com/channel/UC0PvefOBdtlUEaqeqwLvdlQ', s.youtube)
  .replaceAll('https://nl.linkedin.com/in/justinnederkoorn', s.linkedin)
  .replaceAll('hello@talesofjustin.com', s.email);

const siteTitle = 'Tales of Justin';
const fullTitle = title ? `${title} — ${siteTitle}` : siteTitle;
const desc = description || 'Justin Nederkoorn films people who go outside, and the brands that take them there. Brand films, social content and photography from the Netherlands.';
const ogImage = image || IMG(c.projects[0]?.stills[0], 1200);
const canonical = new URL(path, Astro.site).href;
// keep the payload lean: the script only needs these fields
const data = JSON.stringify({ projects: c.projects, reviews: c.reviews, clients: c.clients, bts: c.bts, landing: c.landing, settings: c.settings, media: c.media, local: c.local }).replace(/</g, '\\u003c');
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>{fullTitle}</title>
<meta name="description" content={desc}>
<link rel="canonical" href={canonical}>
<meta property="og:type" content="website">
<meta property="og:title" content={fullTitle}>
<meta property="og:description" content={desc}>
<meta property="og:image" content={ogImage.startsWith('http') ? ogImage : new URL(ogImage, Astro.site).href}>
<meta property="og:url" content={canonical}>
<meta name="twitter:card" content="summary_large_image">
<meta name="theme-color" content="#000000">
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,400..900&family=Instrument+Serif:ital@0;1&family=Caveat:wght@500;600&family=Courier+Prime:ital,wght@0,400;0,700;1,400&display=swap">
<script is:inline src="/vendor/gsap.min.js"></script>
<script is:inline src="/vendor/ScrollTrigger.min.js"></script>
<script is:inline src="/vendor/lenis.min.js"></script>
</head>
<body>
<Fragment set:html={html} />
<script is:inline set:html={`window.__TOJ=${data};`}></script>
<script is:inline src="/app.js"></script>
</body>
</html>
